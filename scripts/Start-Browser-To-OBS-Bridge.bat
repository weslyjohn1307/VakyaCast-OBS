@echo off
title VakyaCast Cross-Browser HTTP Sync Bridge (Port 8765)
echo ====================================================================
echo   VakyaCast Cross-Browser Bridge (Port 8765)
echo   Operate in Chrome/Edge/Firefox -^> Live Update in OBS Browser Source
echo ====================================================================
echo.
echo Starting built-in Windows HTTP Sync Bridge on http://localhost:8765 ...
start "" "http://localhost:8765/bible_lower_third_studio.html"
powershell -NoProfile -ExecutionPolicy Bypass -Command "$l = New-Object System.Net.HttpListener; $l.Prefixes.Add('http://localhost:8765/'); $l.Prefixes.Add('http://127.0.0.1:8765/'); $l.Start(); $state = '{\"isLive\":false}'; $prefsFile = 'C:\OBS-VakyaCast\vakyacast_prefs.json'; $prefs = if (Test-Path $prefsFile) { [System.IO.File]::ReadAllText($prefsFile) } else { '{}' }; Write-Host '[READY] Control URL:     http://localhost:8765/bible_lower_third_studio.html' -ForegroundColor Green; Write-Host '[READY] OBS Overlay URL: http://localhost:8765/bible_lower_third_studio.html?mode=overlay' -ForegroundColor Cyan; while ($l.IsListening) { $ctx = $l.GetContext(); $req = $ctx.Request; $res = $ctx.Response; $res.Headers.Add('Access-Control-Allow-Origin','*'); $res.Headers.Add('Access-Control-Allow-Methods','GET, POST, OPTIONS'); $res.Headers.Add('Access-Control-Allow-Headers','Content-Type'); if ($req.HttpMethod -eq 'OPTIONS') { $res.StatusCode = 200; $res.Close(); continue } if ($req.Url.AbsolutePath -eq '/sync' -and $req.HttpMethod -eq 'POST') { $sr = New-Object System.IO.StreamReader($req.InputStream, [System.Text.Encoding]::UTF8); $state = $sr.ReadToEnd(); $buf = [System.Text.Encoding]::UTF8.GetBytes('{\"ok\":true}'); $res.ContentType = 'application/json'; $res.OutputStream.Write($buf,0,$buf.Length); $res.Close(); continue } if ($req.Url.AbsolutePath -eq '/state') { $buf = [System.Text.Encoding]::UTF8.GetBytes($state); $res.ContentType = 'application/json'; $res.OutputStream.Write($buf,0,$buf.Length); $res.Close(); continue } if ($req.Url.AbsolutePath -eq '/prefs' -and $req.HttpMethod -eq 'POST') { $sr = New-Object System.IO.StreamReader($req.InputStream, [System.Text.Encoding]::UTF8); $prefs = $sr.ReadToEnd(); try { [System.IO.File]::WriteAllText($prefsFile, $prefs, (New-Object System.Text.UTF8Encoding($false))) } catch {}; $buf = [System.Text.Encoding]::UTF8.GetBytes('{\"ok\":true}'); $res.ContentType = 'application/json'; $res.OutputStream.Write($buf,0,$buf.Length); $res.Close(); continue } if ($req.Url.AbsolutePath -eq '/prefs') { $buf = [System.Text.Encoding]::UTF8.GetBytes($prefs); $res.ContentType = 'application/json'; $res.OutputStream.Write($buf,0,$buf.Length); $res.Close(); continue } $rawPath = [System.Uri]::UnescapeDataString($req.Url.AbsolutePath.TrimStart('/')); $file = Join-Path 'C:\OBS-VakyaCast' $rawPath; if (!(Test-Path $file)) { $file = Join-Path $PSScriptRoot $rawPath }; if (Test-Path $file -PathType Leaf) { $bytes = [System.IO.File]::ReadAllBytes($file); if ($file.EndsWith('.json')) { $res.ContentType = 'application/json; charset=utf-8' } elseif ($file.EndsWith('.js')) { $res.ContentType = 'application/javascript; charset=utf-8' } elseif ($file.EndsWith('.css')) { $res.ContentType = 'text/css; charset=utf-8' } else { $res.ContentType = 'text/html; charset=utf-8' }; $res.OutputStream.Write($bytes,0,$bytes.Length) } else { $res.StatusCode = 404 }; $res.Close() }"
pause
